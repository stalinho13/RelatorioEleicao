<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Pauta de conversas — {{ d.cidade }}/{{ d.uf }}</title>
<link rel="stylesheet" href="pauta.css">
<style>
  @page { @bottom-left { content: "Pauta de conversas · {{ d.cidade }}/{{ d.uf }} · 2º turno"; } }
</style>
</head>
<body>
{% set na = d.numeros_absolutos %}
{% set pc = d.percentuais %}
{% set cl = d.classificacao or {} %}
{% set conta = d.conta or {} %}

{# =================== CAPA =================== #}
<section class="capa">
  <div class="capa-topo">
    <div class="selo">2º turno · dia 25</div>
    <img class="logo" src="logo-jpt-sem-fundo.svg" alt="JPT Juventude">
  </div>
  <div class="titulo">Pauta de<br>conversas</div>
  <div class="cidade">{{ d.cidade }}<small>{{ d.uf }}</small></div>
  {% if cl.rotulo %}<div class="classe">{{ cl.rotulo }}</div>{% endif %}
  {% if cl.explicacao %}<p class="explica">{{ cl.explicacao }}</p>{% endif %}
  <div class="placar">
    <div><b class="num">{{ na.eleitorado|n }}</b><span>eleitores</span></div>
    <div class="lula"><b class="num">{{ pc.lula_pct_validos|p }}</b><span>Lula · {{ na.lula|n }} votos</span></div>
    <div><b class="num">{{ pc.flavio_pct_validos|p }}</b><span>Flávio · {{ na.flavio|n }} votos</span></div>
  </div>
  <div class="rodape-capa">
    Dados do 1º turno de 2026 · {{ pc.apuracao_pct|p }} das urnas apuradas · gerado em {{ d.snapshot.data|data }}
    {% if d.snapshot.versao_dado %} · versão do dado {{ d.snapshot.versao_dado }}{% endif %}<br>
    Fonte: Onde dá pra conversar (ondedapraconversar.com.br), a partir dos boletins de urna do TSE.
  </div>
</section>

{# =================== 1. PLACAR =================== #}
<section class="secao">
  <div class="faixa">
    <div class="kicker">1 · Números absolutos · 1º turno</div>
    <h2>O placar em {{ d.cidade }}</h2>
    <p>{{ na.regioes }} regiões de votação em {{ na.bairros }} bairros. Flávio venceu em {{ na.regioes_flavio_vence }} regiões e {{ na.bairros_flavio_vence }} bairros.</p>
  </div>

  <div class="kpis">
    <div class="kpi"><div class="rot">Eleitorado</div><div class="val num">{{ na.eleitorado|n }}</div>
      <div class="sub">{% if na.eleitorado_tse %}TSE: {{ na.eleitorado_tse|n }}{% if na.diferenca_tse == 0 %} · confere{% else %} · dif. {{ na.diferenca_tse|n }}{% endif %}{% else %}soma das regiões{% endif %}</div></div>
    <div class="kpi"><div class="rot">Urnas</div><div class="val num">{{ na.urnas|n }}</div>
      <div class="sub">{{ na.urnas_apuradas|n }} apuradas ({{ pc.apuracao_pct|p }})</div></div>
    <div class="kpi"><div class="rot">Comparecimento</div><div class="val num">{{ na.comparecimento|n }}</div>
      <div class="sub">{{ pc.comparecimento_pct_eleitorado|p }} do eleitorado</div></div>
    <div class="kpi destaque"><div class="rot">Abstenção</div><div class="val num">{{ na.abstencao|n }}</div>
      <div class="sub">{{ pc.abstencao_pct_eleitorado|p }} do eleitorado</div></div>
    <div class="kpi"><div class="rot">Votos válidos</div><div class="val num">{{ na.votos_validos|n }}</div>
      <div class="sub">base dos percentuais por candidato</div></div>
    <div class="kpi"><div class="rot">Brancos</div><div class="val num">{{ na.brancos|n }}</div>
      <div class="sub">{{ pc.brancos_pct_comparecimento|p }} de quem foi votar</div></div>
    <div class="kpi"><div class="rot">Nulos</div><div class="val num">{{ na.nulos|n }}</div>
      <div class="sub">{{ pc.nulos_pct_comparecimento|p }} de quem foi votar</div></div>
    <div class="kpi"><div class="rot">Outros candidatos</div><div class="val num">{{ na.outros|n }}</div>
      <div class="sub">{{ pc.outros_pct_validos|p }} dos válidos</div></div>
  </div>

  <div class="bloco">
    <h3>Votos por candidato</h3>
    {% set vmax = (d.votos_por_candidato|map(attribute='votos')|max) or 1 %}
    <div class="barras">
      {% for c in d.votos_por_candidato %}
        {% set cor = 'c-lula' if c.numero == '13' else ('c-flavio' if c.numero == '22' else ('c-ponte' if c.ponte else 'c-outros')) %}
        <div class="nome">{{ c.nome }} <small>{{ c.numero }}</small></div>
        <div class="trilho"><div class="barra {{ cor }}" style="width: {{ (c.votos / vmax * 100)|round(2) }}%"></div></div>
        <div class="valor num"><b>{{ c.votos|n }}</b> · {{ c.pct_validos|p(2) }}</div>
      {% endfor %}
    </div>
    <div class="legenda">
      <span><i class="c-lula"></i>Lula</span><span><i class="c-flavio"></i>Flávio</span>
      <span><i class="c-ponte"></i>Candidatos-ponte (há pontos em comum com o programa do Lula)</span>
      <span><i class="c-outros"></i>Demais</span>
    </div>
  </div>

  {% set cmp = d.comparacao_lula_2022 %}
  {% if cmp and cmp.lula_2022_2turno %}
  <div class="cartaz">
    <div class="grande">
      {% if cmp.votos_a_mais_em_2022 > 0 %}
        Em 2022, no 2º turno, o Lula teve <em>{{ cmp.votos_a_mais_em_2022|n }} votos a mais</em> em {{ d.cidade }} do que tem agora.
      {% else %}
        O Lula já tem <em>{{ (-cmp.votos_a_mais_em_2022)|n }} votos a mais</em> do que teve no 2º turno de 2022.
      {% endif %}
    </div>
    <div class="linha">
      <div><b class="num">{{ cmp.lula_2022_2turno|n }}</b><span>2º turno 2022</span></div>
      <div class="seta">→</div>
      <div><b class="num">{{ cmp.lula_2026_1turno|n }}</b><span>1º turno 2026</span></div>
      <div><b class="num">{{ cmp.variacao_pct|p(1, sinal=True) }}</b><span>variação</span></div>
    </div>
    <div class="nota">{{ cmp.regioes_com_dado }} regiões com dado nos dois anos. {{ cmp.nota }}</div>
  </div>
  {% endif %}
</section>

{# =================== 2. A CONTA =================== #}
<section class="secao">
  <div class="faixa">
    <div class="kicker">2 · Onde estão os votos</div>
    <h2>A conta</h2>
    <p>Cada voto que muda de lado conta dobrado: sai de um e entra no outro. Por isso a meta é a metade da diferença.</p>
  </div>

  <div class="conta-topo bloco">
    <div class="lider">
      <div class="rotulo">Quem lidera</div>
      <div class="grande"><em>{{ conta.lider }}</em> está {{ conta.diferenca|n }} votos à frente ({{ conta.vantagem_pp|p(1, unidade=' pp') }}).</div>
      {% if cl.explicacao %}<p class="miudo" style="margin-top:3mm">{{ cl.explicacao }}</p>{% endif %}
    </div>
    <div class="metade">
      <b class="num">{{ conta.metade_para_empatar|n }}</b>
      <span>votos trocados de lado<br>empatam a eleição</span>
    </div>
  </div>

  {% set b = conta.bolsoes or {} %}
  {% set bl = [('ponte', 'Eleitores-ponte', 'Caiado, Cury, Renan e Zema'), ('branco_nulo', 'Branco e nulo', 'foram votar e não escolheram'), ('abstencao', 'Abstenção', 'não foram votar')] %}
  {% set bmax = [b.ponte.votos if b.ponte else 0, b.branco_nulo.votos if b.branco_nulo else 0, b.abstencao.votos if b.abstencao else 0]|max or 1 %}
  <div class="bolsoes bloco">
    <h3>Os bolsões, em múltiplos da metade</h3>
    {% for chave, nome, sub in bl if b[chave] %}
      <div class="bolsao">
        <div class="nome">{{ nome }}<small>{{ sub }}</small></div>
        <div class="trilho">
          <div class="barra" style="width: {{ (b[chave].votos / bmax * 100)|round(2) }}%"></div>
          <div class="marca-metade" style="left: {{ (conta.metade_para_empatar / bmax * 100)|round(2) }}%"></div>
        </div>
        <div class="mult"><b class="num">{{ b[chave].multiplo_da_metade|x }}</b><span class="num">{{ b[chave].votos|n }} votos</span></div>
      </div>
      {% if chave == 'ponte' and b.ponte.detalhe %}
        <div class="chips" style="margin: 0 0 1mm 41mm">
          {% for nome_c, v in b.ponte.detalhe|dictsort(by='value', reverse=True) %}<span class="chip">{{ nome_c }} {{ v|n }}</span>{% endfor %}
        </div>
      {% endif %}
    {% endfor %}
    <p class="miudo" style="margin-top:2mm">A linha tracejada marca a metade da diferença ({{ conta.metade_para_empatar|n }} votos).
      {% if b.total %}Somados, os bolsões têm {{ b.total.votos|n }} votos, {{ b.total.multiplo_da_metade|x }} a metade.{% endif %}</p>
  </div>

  {% set pf = d.perfil_eleitor %}
  {% if pf and pf.aptos_2022 %}
  <div class="bloco">
    <h3>Quem costuma ficar em casa · {{ pf.referencia }}</h3>
    <div class="perfil">
      <div class="resumo">
        <div><b class="num">{{ pf.abstencao_2022_pct|p }}</b><span>abstenção no 2º turno de 2022</span></div>
        <div><b class="num">{{ pf.abstencao_2022|n }}</b><span>de {{ pf.aptos_2022|n }} aptos</span></div>
      </div>
      <div>
        {% for g, s in (pf.segmentos.items()|list|sort(attribute='1.inscritos', reverse=True)) %}
          <div class="seg">
            <div><b>{{ g|segmento }}</b></div>
            <div class="trilho"><div class="barra" style="width: {{ s.abstencao_pct|round(1) }}%"></div></div>
            <div class="valor num"><b>{{ s.abstencao_pct|p(0) }}</b> faltaram · {{ s.inscritos|n }} inscritos</div>
          </div>
        {% endfor %}
        <p class="miudo" style="margin-top:2mm">A abstenção total por seção é contada pelo TSE; a divisão por grupo é estimada pelo app. Para a abstenção de 2026, veja o placar. Os grupos só aparecem nas regiões em que são destaque ({{ pf.regioes_com_perfil }} de {{ pf.regioes_total }} regiões têm perfil).</p>
      </div>
    </div>
  </div>
  {% endif %}
</section>

{# =================== 3. BAIRROS =================== #}
{% set rg = d.regioes or {} %}
<section class="secao">
  <div class="faixa">
    <div class="kicker">3 · Perfil por território</div>
    <h2>Os bairros</h2>
    <p>Do maior para o menor eleitorado. A barra mostra os votos válidos: Lula, Flávio e os demais.</p>
  </div>

  <table>
    <thead><tr>
      <th>Bairro</th><th class="n">Eleitores</th><th class="n">Lula</th><th class="n">Flávio</th>
      <th class="n">Vantagem</th><th>Válidos</th><th class="n">Abstenção</th><th>Categoria</th>
    </tr></thead>
    <tbody>
    {% for x in rg.bairros or [] %}
      <tr>
        <td class="bairro">{{ x.bairro }}</td>
        <td class="n num">{{ x.eleitorado|n }}</td>
        <td class="n num">{{ x.lula_pct_validos|p }}</td>
        <td class="n num">{{ x.flavio_pct_validos|p }}</td>
        <td class="n num">{% if x.vantagem_flavio_pp < 0 %}<span class="dif-l">Lula +{{ (-x.vantagem_flavio_pp)|dec }}</span>{% elif x.vantagem_flavio_pp > 0 %}<span class="dif-f">Flávio +{{ x.vantagem_flavio_pp|dec }}</span>{% else %}empate{% endif %}</td>
        <td><div class="split"><div class="l" style="width:{{ x.lula_pct_validos }}%"></div><div class="f" style="width:{{ x.flavio_pct_validos }}%"></div><div class="o" style="flex:1"></div></div></td>
        <td class="n num">{{ x.abstencao_pct_eleitorado|p }}{% if x.abstencao_alta %} ▲{% endif %}</td>
        <td><span class="cat {{ x.categoria }}">{{ x.categoria|categoria }}</span></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="miudo" style="margin-top:2mm">Vantagem em pontos percentuais dos votos válidos. ▲ = abstenção de 30% ou mais.</p>

  <div class="grupos">
    <div class="grupo"><h4><span class="cat base_a_segurar">Base a segurar</span></h4>
      <p>Lula na frente. Trabalho: garantir que essa gente vote no dia 25.</p>
      <div class="chips">{% for n in rg.base_a_segurar or [] %}<span class="chip">{{ n }}</span>{% else %}<span class="miudo">nenhum</span>{% endfor %}</div></div>
    <div class="grupo"><h4><span class="cat periferia_conversavel">Periferia conversável</span></h4>
      <p>Flávio na frente por até 10 pontos. Onde a conversa vira voto.</p>
      <div class="chips">{% for n in rg.periferia_conversavel or [] %}<span class="chip">{{ n }}</span>{% else %}<span class="miudo">nenhum</span>{% endfor %}</div></div>
    <div class="grupo"><h4><span class="cat terreno_de_flavio">Terreno de Flávio</span></h4>
      <p>Flávio com mais de 10 pontos. Conversa mais lenta; foco em quem não votou.</p>
      <div class="chips">{% for n in rg.terreno_de_flavio or [] %}<span class="chip">{{ n }}</span>{% else %}<span class="miudo">nenhum</span>{% endfor %}</div></div>
  </div>

  {% set app = d.situacao_no_app %}
  {% if app %}
  <div class="bloco" style="margin-top:6mm">
    <h3>Quem já está conversando pelo app</h3>
    <div class="app">
      <div class="kpi"><div class="rot">Pessoas cadastradas</div><div class="val num">{{ app.pessoas_cadastradas|n }}</div></div>
      <div class="kpi"><div class="rot">Regiões com gente</div><div class="val num">{{ app.regioes_com_marca|n }}</div><div class="sub">de {{ app.regioes_consultadas|n }} regiões</div></div>
      <div class="kpi"><div class="rot">Território aberto?</div><div class="val">{{ 'Sim' if app.territorio_aberto else 'Não' }}</div><div class="sub">{{ 'quase ninguém cadastrado ainda' if app.territorio_aberto else 'já tem gente conversando' }}</div></div>
      <div class="kpi"><div class="rot">Por bairro</div>
        <div class="chips" style="margin-top:2mm">{% for n, v in (app.por_bairro or {}).items() %}<span class="chip">{{ n }} · {{ v }}</span>{% else %}<span class="miudo">ninguém ainda</span>{% endfor %}</div></div>
    </div>
  </div>
  {% endif %}
</section>

{# =================== 4. RANKING =================== #}
{% set rk = d.ranking_das_pautas or [] %}
<section class="secao">
  <div class="faixa">
    <div class="kicker">4 · Da mais para a menos relevante</div>
    <h2>Ranking das pautas</h2>
    <p>Ordenadas pelo tamanho do público. "× metade" diz quantas vezes esse público cabe na metade da diferença ({{ conta.metade_para_empatar|n }} votos).</p>
  </div>

  {% set pmax = (rk|map(attribute='publico')|max) or 1 %}
  <div class="ranking-lista">
    <div class="rk cabeca"><div>#</div><div>Pauta</div><div style="text-align:right">Público</div><div style="text-align:right">× metade</div><div>Tamanho</div></div>
    {% for p in rk %}
      <div class="rk">
        <div class="pos">{{ p.posicao }}</div>
        <div class="t">{{ p.pauta }}<small>{{ p.acao }}{% if p.onde %} · {{ p.onde[:3]|join(', ') }}{% endif %}</small></div>
        <div class="pub num">{{ p.publico|n }}<small>{{ p.pct_eleitorado|p }} do eleitorado</small></div>
        <div class="x num">{{ p.multiplo_da_metade|x }}</div>
        <div class="trilho"><div class="barra" style="width: {{ (p.publico / pmax * 100)|round(2) }}%"></div></div>
      </div>
    {% endfor %}
  </div>

  {% for p in rk %}
    <div class="pauta">
      <div class="pauta-topo">
        <div class="pos">{{ p.posicao }}</div>
        <div class="txt">
          <h3>{{ p.material.titulo if p.material and p.material.titulo else p.pauta }}</h3>
          <div class="meta"><b class="num">{{ p.publico|n }}</b> pessoas · {{ p.pct_eleitorado|p }} do eleitorado · {{ p.multiplo_da_metade|x }} a metade · <b>{{ p.acao }}</b></div>
        </div>
      </div>
      <div class="pauta-corpo">
        <div class="linha2">
          <div><div class="rotulo">Onde</div><div class="chips">{% for o in p.onde or [] %}<span class="chip contorno">{{ o }}</span>{% endfor %}</div></div>
          <div><div class="rotulo">Temas para abrir nas Propostas</div><div class="chips">{% for t in p.temas or [] %}<span class="chip amarelo">{{ t|tema }}</span>{% endfor %}</div></div>
        </div>
        {% if p.candidatos %}
          <div style="margin-top:3mm"><div class="rotulo">Candidatos</div><div class="chips">{% for n, v in p.candidatos.items() %}<span class="chip">{{ n }} · {{ v|n }}</span>{% endfor %}</div></div>
        {% endif %}

        {% set m = p.material %}
        {% if m and m.frase %}
          <div class="frase">“{{ m.frase }}”</div>
          {% if m.apoio %}<div class="apoio">{{ m.apoio }}</div>{% endif %}
          {% if m.explicacao %}<div class="rotulo">Para explicar</div><ul>{% for e in m.explicacao %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
          {% if m.roteiro %}<div class="rotulo">Roteiro da conversa</div><ol>{% for r in m.roteiro %}<li>{{ r }}</li>{% endfor %}</ol>{% endif %}
          {% if m.cuidado %}<div class="cuidado"><div class="rotulo">Cuidado</div>{{ m.cuidado }}</div>{% endif %}
        {% elif m and m.pontes %}
          {% if m.abertura %}<div class="abertura">{{ m.abertura }}</div>{% endif %}
          <div class="rotulo">Pontos em comum</div>
          <div class="pontes">
            {% for pt in m.pontes %}
              <div class="ponte">
                <h4>{{ pt.tema }}{% if pt.tipo %}<span class="tipo {{ pt.tipo }}">{{ pt.tipo }}</span>{% endif %}</h4>
                <p>{{ pt.em_comum }}</p>
                {% if pt.temas_propostas %}<div class="chips">{% for t in pt.temas_propostas %}<span class="chip">{{ t|tema }}</span>{% endfor %}</div>{% endif %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="sem-material">Sem ficha própria para esta pauta: use o roteiro geral (última página) e os temas acima.</p>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</section>

{# =================== 5. TEMAS =================== #}
{% set tp = d.temas_para_abrir_nas_propostas or {} %}
<section class="secao">
  <div class="faixa">
    <div class="kicker">5 · O que mostrar na página de Propostas</div>
    <h2>Temas para abrir nas propostas</h2>
    <p>Do tema que alcança mais gente para o que alcança menos. O número da página remete ao programa de governo.</p>
  </div>

  {% set cols = tp.por_relevancia or [] %}
  {% if tp.por_pauta and cols %}
  <div class="bloco">
    <h3>Qual tema para qual pauta</h3>
    <table class="matriz">
      <thead><tr><th></th>{% for t in cols %}<th class="vert"><div>{{ t.titulo }}</div></th>{% endfor %}</tr></thead>
      <tbody>
      {% for linha in tp.por_pauta %}
        {% set ids = linha.temas|map(attribute='id')|list %}
        <tr><td class="p">{{ linha.pauta }}</td>{% for t in cols %}<td>{% if t.id in ids %}<span class="ponto"></span>{% else %}<span class="vazio"></span>{% endif %}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="temas">
    {% for t in cols %}
      <div class="tema">
        <div class="topo"><div class="n">{{ loop.index }}</div><h4>{{ t.titulo }}</h4></div>
        <div class="corpo">
          {% if t.chamada %}<div class="chamada">{{ t.chamada }}</div>{% endif %}
          <div class="alcance">Alcança <b class="num">{{ t.publico_alcancado|n }}</b> pessoas em {{ t.pautas|length }} pauta{{ 's' if t.pautas|length != 1 }}</div>
          <div class="chips">{% for pid in t.pautas %}<span class="chip">{{ pid|pauta }}</span>{% endfor %}</div>
          <ul>{% for pr in t.propostas %}<li>{{ pr.titulo }}{% if pr.pagina %}<span>p. {{ pr.pagina }}</span>{% endif %}</li>{% endfor %}</ul>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{# =================== 6. ROTEIRO GERAL =================== #}
<section class="secao">
  <div class="faixa">
    <div class="kicker">6 · Vale para qualquer conversa</div>
    <h2>Roteiro geral</h2>
  </div>
  <ol class="roteiro">{% for r in d.roteiro_geral or [] %}<li>{{ r }}</li>{% endfor %}</ol>

  {% set ck = d.checagens or {} %}
  {% if d.avisos or ck.falhas_identidade_abstencao or ck.regioes_com_urna_sem_boletim %}
  <div class="avisos">
    <div class="rotulo">Avisos sobre os dados</div>
    <ul>
      {% for a in d.avisos or [] %}<li>{{ a }}</li>{% endfor %}
      {% if ck.regioes_com_urna_sem_boletim %}<li>{{ ck.regioes_com_urna_sem_boletim|length }} região(ões) com urna ainda sem boletim.</li>{% endif %}
      {% if ck.falhas_identidade_abstencao %}<li>{{ ck.falhas_identidade_abstencao|length }} região(ões) não fecham a conta eleitores = votos + abstenção.</li>{% endif %}
    </ul>
  </div>
  {% endif %}

  <div class="fontes">
    <b>Fonte:</b> {{ d.snapshot.fonte_celulas }} · versão do dado {{ d.snapshot.versao_dado or '—' }}
    {% if d.snapshot.gerado_em_app %}(atualizado no app em {{ d.snapshot.gerado_em_app|data }}){% endif %} ·
    fichas: {{ d.snapshot.fichas }} · propostas: {{ d.snapshot.propostas }} ·
    coordenadas {{ d.coordenadas.lat }}, {{ d.coordenadas.lon }}.
